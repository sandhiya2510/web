
<definitions name="BookService"
 xmlns="http://schemas.xmlsoap.org/wsdl/"
 xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
 xmlns:tns="http://test.com/book"
 xmlns:xsd="http://www.w3.org/2001/XMLSchema"
 targetNamespace="http://test.com/book">

 <message name="AddReq">
  <part name="title" type="xsd:string"/>
 </message>
 <message name="AddRes">
  <part name="message" type="xsd:string"/
 </message>

 <portType name="BookPort">
  <operation name="addBook">
   <input message="tns:AddReq"/
   <output message="tns:AddRes"/>
  </operation>
 </portType>

 <binding name="BookBinding" type="tns:BookPort">
  <soap:binding style="rpc"
   transport="http://schemas.xmlsoap.org/soap/http"/>
  <operation name="addBook">
   <soap:operation soapAction="addBook"/>
   <input><soap:body use="literal" namespace="http://test.com/book"/></input>
   <output><soap:body use="literal" namespace="http://test.com/book"/></output>
  </operation>
 </binding>
 <service name="BookService">
  <port name="BookPort" binding="tns:BookBinding">
   <soap:address location="http://localhost:8000/book"/>
  </port>
 </service>
</definitions>
